#!/usr/bin/env bash
# script to display information about subdomains

display_info() {
    # shellcheck disable=SC2086
    dig $2.$1 | awk -v sub="$2" '/^;; ANSWER SECTION:/ {
        getline
        print "The subdomain " sub " is a " $4 " record and points to " $5
    }'
}

if [ $# -eq 1 ]; then
    display_info $1 www
    display_info $1 lb-01
    display_info $1 web-01
    display_info $1 web-02
elif [ $# -eq 2 ]; then
    display_info $1 $2
fi